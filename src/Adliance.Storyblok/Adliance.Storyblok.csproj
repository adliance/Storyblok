<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Adliance.Storyblok</AssemblyName>
        <RootNamespace>Adliance.Storyblok</RootNamespace>
        <PackageId>Adliance.Storyblok</PackageId>
        <Version>0.0.0</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>
        <Authors>Hannes Sachsenhofer</Authors>
        <Company>Adliance GmbH</Company>
        <Product>Adliance.Storyblok</Product>
        <Description>Easily integrate the Storyblok headless CMS into your ASP.NET core application.</Description>
        <Copyright>(c) Adliance GmbH</Copyright>
        <PackageProjectUrl>https://github.com/Adliance/Storyblok/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Adliance/Storyblok/</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildThisFileDirectory)../../CHANGELOG.md"))</PackageReleaseNotes>

        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Markdig" Version="0.43.0" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
        <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
</Project>

