<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Adliance.Storyblok.FulltextSearch</AssemblyName>
    <RootNamespace>Adliance.Storyblok.FulltextSearch</RootNamespace>
    <PackageId>Adliance.Storyblok.FulltextSearch</PackageId>
    <Version>0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <Authors>Hannes Sachsenhofer</Authors>
    <Company>Adliance GmbH</Company>
    <Product>Adliance.Storyblok</Product>
    <Description>Extends the Adliance.Storyblok package with support for fulltext search.</Description>
    <Copyright>(c) Adliance GmbH</Copyright>
    <PackageProjectUrl>https://github.com/Adliance/Storyblok/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Adliance/Storyblok/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/adliance/Storyblok/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <NoWarn>NU5104</NoWarn>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Adliance.Storyblok" Version="8.1.9" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Highlighter" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Queries" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>

